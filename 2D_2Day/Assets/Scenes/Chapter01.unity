  m_Script: {fileID: 11500000, guid: 5fcfdca6122f2e54d852c8e6080a3ecc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    dialogueLines:
    - character:
        name: Chen
        icon: {fileID: 8707792856259278305, guid: 167cec2c9ba3e454b972a4fae1c7f189, type: 3}
        icon2: {fileID: -3084705627165444340, guid: 9ddeb4ee5548be541b4d0295f7350da5, type: 3}
      line: "\u0E40\u0E2E\u0E49\u0E22\u0E1E\u0E27\u0E01... \u0E09\u0E31\u0E19\u0E02\u0E2D\u0E0B\u0E48\u0E2D\u0E19\u0E2B\u0E25\u0E31\u0E07\u0E1A\u0E32\u0E23\u0E4C\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E08\u0E30\u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21"
    - character:
        name: Chen
        icon: {fileID: 8213111197245933535, guid: 7f313ce390c77044d937e1483f433ff1, type: 3}
        icon2: {fileID: -3084705627165444340, guid: 9ddeb4ee5548be541b4d0295f7350da5, type: 3}
      line: "\u0E44\u0E2D\u0E1E\u0E27\u0E01\u0E15\u0E33\u0E23\u0E27\u0E08\u0E21\u0E31\u0E19\u0E44\u0E25\u0E48\u0E09\u0E31\u0E19\u0E21\u0E32\u0E19\u0E30"
    - character:
        name: Me
        icon: {fileID: 8213111197245933535, guid: 7f313ce390c77044d937e1483f433ff1, type: 3}
        icon2: {fileID: 4932163390197376912, guid: 8687157a7f94c364d89fb85962b5ad82, type: 3}
      line: "\u0E19\u0E35\u0E49\u0E2B\u0E32\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E09\u0E31\u0E19\u0E0A\u0E31\u0E14\u0E46\u0E40\u0E25\u0E22
        \u0E16\u0E49\u0E32\u0E40\u0E01\u0E34\u0E14\u0E42\u0E14\u0E19\u0E08\u0E31\u0E1A\u0E44\u0E14\u0E49\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E25\u0E30"
    - character:
        name: Chen
        icon: {fileID: 8213111197245933535, guid: 7f313ce390c77044d937e1483f433ff1, type: 3}
        icon2: {fileID: -3084705627165444340, guid: 9ddeb4ee5548be541b4d0295f7350da5, type: 3}
      line: "\u0E40\u0E2D\u0E32\u0E19\u0E49\u0E32\u0E32\u0E32 \u0E09\u0E31\u0E19\u0E02\u0E2D\u0E23\u0E49\u0E2D\u0E07\u0E25\u0E30\u0E1E\u0E27\u0E01"
    - character:
        name: Me
        icon: {fileID: 8707792856259278305, guid: 167cec2c9ba3e454b972a4fae1c7f189, type: 3}
        icon2: {fileID: 4932163390197376912, guid: 8687157a7f94c364d89fb85962b5ad82, type: 3}
      line: "\u0E40\u0E2E\u0E49\u0E2D\u0E2D\u0E2D\u0E2D \u0E01\u0E47\u0E44\u0E14\u0E49\u0E44\u0E1B\u0E2B\u0E25\u0E1A\u0E2B\u0E25\u0E31\u0E07\u0E1A\u0E32\u0E23\u0E4C\u0E41\u0E25\u0E30\u0E01\u0E47\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E34\u0E48\u0E07\u0E46\u0E25\u0E30"
  DialogueUI: {fileID: 1258707771}
