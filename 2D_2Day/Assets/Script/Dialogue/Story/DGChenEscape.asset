    line: " \u0E2D\u0E31\u0E4A\u0E27 \u0E2D\u0E32\u0E40\u0E09\u0E34\u0E19 \u0E41\u0E2B\u0E48\u0E07\u0E41\u0E01\u0E4A\u0E07\u0E21\u0E31\u0E07\u0E01\u0E23\u0E41\u0E14\u0E07
      \u0E08\u0E30\u0E15\u0E2D\u0E1A\u0E41\u0E17\u0E19\u0E1A\u0E38\u0E0D\u0E04\u0E38\u0E13\u0E43\u0E19\u0E04\u0E23\u0E31\u0E49\u0E07\u0E19\u0E35\u0E49\u0E41\u0E19\u0E48\u0E19\u0E2D\u0E19"
    hasChoices: 0
    choices: []
  - side: 1
    character:
      name: Mc
      icon: {fileID: 8707792856259278305, guid: 167cec2c9ba3e454b972a4fae1c7f189, type: 3}
      icon2: {fileID: 4932163390197376912, guid: 8687157a7f94c364d89fb85962b5ad82, type: 3}
    line: "\u0E0A\u0E31\u0E48\u0E07\u0E21\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30\u0E41\u0E04\u0E48\u0E2D\u0E22\u0E48\u0E32\u0E25\u0E32\u0E01\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E21\u0E32\u0E43\u0E2B\u0E49\u0E01\u0E47\u0E1E\u0E2D\u0E41\u0E25\u0E49\u0E27"
    hasChoices: 0
    choices: []
  - side: 1
    character:
      name: Achen
      icon: {fileID: 8707792856259278305, guid: 167cec2c9ba3e454b972a4fae1c7f189, type: 3}
      icon2: {fileID: 4932163390197376912, guid: 8687157a7f94c364d89fb85962b5ad82, type: 3}
    line: "\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E2B\u0E48\u0E27\u0E07 \u0E40\u0E2D\u0E2D\u2026.\u0E40\u0E16\u0E49\u0E32\u0E41\u0E01\u0E48\u0E0A\u0E37\u0E48\u0E2D\u0E27\u0E48\u0E32\u2026\u0E2D\u0E30\u0E44\u0E23\r\n"
    hasChoices: 0
